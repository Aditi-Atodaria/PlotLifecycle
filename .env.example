# Copy to .env and fill in. Never commit the real .env file.

# Passwords for the three demo accounts, used only the FIRST time the database is created.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_AGENT_PASSWORD=change-me-agent
SEED_ACCOUNTANT_PASSWORD=change-me-accountant

# Let visitors create AGENT / ACCOUNTANT accounts at /register (admins are never self-registered)
ALLOW_REGISTRATION=true

# Show the demo logins on the sign-in page. Only for a public demo using the default passwords.
SHOW_DEMO_CREDENTIALS=false

# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# Optional
# PORT=8080
# DB_PATH=/data/realestate.db
# SHOW_SQL=false
